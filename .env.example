# Finance Agent configuration. Copy to .env and fill in. Never commit real credentials.

# FRED/ALFRED API key (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# REQUIRED for live SEC access. SEC fair-access policy: identify yourself with contact info.
SEC_USER_AGENT="FinanceAgent/0.1 your.name@example.com"

# Optional. Enables LLM request interpretation + narrative synthesis (Claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_ENABLED=true

# SQLite by default; any SQLAlchemy URL works (schema is PostgreSQL-compatible), e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/finance_agent
DATABASE_URL=sqlite:///./data/finance_agent.db
DATA_DIR=./data

LOG_LEVEL=INFO
LOG_JSON=true

# true = serve SEC/FRED responses from tests/fixtures (no network, no keys needed)
OFFLINE_MODE=false
