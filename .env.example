# AlphaForge configuration. Copy to .env and fill in. Never commit real credentials.

# FRED/ALFRED API key (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# REQUIRED for live SEC access. SEC fair-access policy: identify yourself with contact info.
SEC_USER_AGENT="AlphaForge/0.1 your.name@example.com"

# Optional. Enables LLM request interpretation + narrative synthesis (Claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_ENABLED=true

# SQLite by default; any SQLAlchemy URL works (schema is PostgreSQL-compatible), e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/finance_agent
DATABASE_URL=sqlite:///./data/finance_agent.db
DATA_DIR=./data

LOG_LEVEL=INFO
LOG_JSON=true

# true = serve SEC/FRED responses from tests/fixtures (no network, no keys needed)
OFFLINE_MODE=false

# v0.2 event intelligence
# Enables POST /intelligence/ingest for loopback clients sending a matching X-Admin-Token.
# Leave empty to keep HTTP ingestion disabled (use the CLI instead).
INGEST_ADMIN_TOKEN=
# true: macro releases confirmed by ALFRED use the official scheduled release time;
# false: strict next-day (00:00 New York) availability.
MACRO_USE_CONFIRMED_SCHEDULED_TIME=true

# v0.3-A market data (Alpaca Market Data API; free account at https://alpaca.markets).
# Without keys, live market ingestion is refused; --offline uses SYNTHETIC fixtures.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# sip = consolidated tape (all US exchanges); iex = IEX only (partial volume)
ALPACA_FEED=sip
# Daily moves beyond this fraction are flagged for review (never deleted)
MARKET_EXTREME_RETURN_THRESHOLD=0.25
